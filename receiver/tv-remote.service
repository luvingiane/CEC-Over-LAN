# Unità systemd UTENTE (non serve root). NON ancora installata.
# Installazione prevista, dopo il via del proprietario:
#   mkdir -p ~/.config/systemd/user
#   cp tv-remote.service ~/.config/systemd/user/
#   echo 'TV_TARGET=<IP_TV>:<PORTA>' > ~/vm170-tv-remote/tv-remote.env
#   systemctl --user daemon-reload && systemctl --user enable --now tv-remote
#   loginctl enable-linger $USER      # avvio al boot senza login (richiede permesso)
# Rimozione: systemctl --user disable --now tv-remote; rm ~/.config/systemd/user/tv-remote.service
[Unit]
Description=Telecomando Google TV -> uinput (VM 170)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/vm170-tv-remote/tv-remote.env
ExecStart=/usr/bin/python3 -B %h/vm170-tv-remote/tv_remote.py --target ${TV_TARGET}
Restart=always
RestartSec=2
# Il riavvio e il backoff delle connessioni adb sono gestiti anche dentro lo script.

[Install]
WantedBy=default.target
